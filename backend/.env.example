# Modèle du fichier .env — copier en `.env` et renseigner les valeurs.
# Ne JAMAIS versionner le fichier .env (il est exclu par .gitignore).
# Toutes les clés d'API restent côté backend : l'app mobile n'en contient aucune.

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=

# --- Base de données PostgreSQL ---
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
# Alternative PaaS (Render/Railway) : prend le dessus sur DB_* si renseignée
DATABASE_URL=

# --- Redis ---
REDIS_HOST=
REDIS_PORT=

# --- Contrôle IA des demandes ---
# "simulation" (mots-clés, sans API) ou "reel" (Groq, + Google Vision en option)
IA_FOURNISSEUR=
# Budget total du contrôle IA, en secondes (BNF-04 : 30 s maximum)
IA_BUDGET_SECONDES=
# Détection d'objets : "groq" (défaut) ou "google" (ajoute Google Cloud Vision)
IA_DETECTION=
# Nombre d'images extraites de la vidéo et analysées
IA_NB_IMAGES=

# --- Google Cloud Vision ---
# Chemin vers la clé JSON du compte de service (placée dans backend/secrets/,
# dossier exclu du dépôt). Le compte de service ne doit avoir que le rôle
# nécessaire à l'API Vision.
GOOGLE_APPLICATION_CREDENTIALS=
VISION_TIMEOUT_SECONDS=
# Score minimal (0 à 1) pour qu'une étiquette détectée soit prise en compte
VISION_SEUIL_CONFIANCE=

# --- Groq (détection, cohérence description/vidéo, altération) ---
GROQ_API_KEY=
# Modèle vision-langage (défaut : qwen/qwen3.8-27b)
GROQ_MODEL=
GROQ_TIMEOUT_SECONDS=
# Confiance minimale (0 à 1) pour rejeter un objet interdit signalé par Groq
GROQ_SEUIL_CONFIANCE=
# Nombre maximal d'images par requête accepté par le modèle (3 pour qwen3.8-27b)
GROQ_MAX_IMAGES=
# Longueur maximale de la réponse, en jetons (offre gratuite : 1000 jetons de sortie par minute)
GROQ_MAX_TOKENS=

# --- CamPay (paiements MTN MoMo / Orange Money) ---
# Identifiants de l'application CamPay (section "App keys" du tableau de bord)
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
# Clé du webhook (App Webhook Key) : vérifie que les notifications viennent de CamPay
CAMPAY_WEBHOOK_KEY=
# "demo" (demo.campay.net, tests) ou "production" (www.campay.net)
CAMPAY_ENV=
CAMPAY_TIMEOUT_SECONDS=
# Taux des frais CamPay en %, lu sur votre tableau de bord (ex. 2 pour 2 %)
CAMPAY_FRAIS_POURCENT=

# --- Smile Identity (KYC) ---
SMILE_PARTNER_ID=
SMILE_API_KEY=
# "sandbox" ou "production"
SMILE_ENV=
# URL publique HTTPS où Smile renvoie le résultat : https://<domaine>/api/kyc/smile-callback/
# (en local, un tunnel type ngrok ; sinon utiliser "manage.py actualiser_kyc")
SMILE_CALLBACK_URL=
SMILE_TIMEOUT_SECONDS=
# "manuel" (validation admin) ou "smile"
KYC_FOURNISSEUR=
# true : une CNI validée est exigée pour activer le rôle Transporteur
KYC_REQUIS_TRANSPORTEUR=
